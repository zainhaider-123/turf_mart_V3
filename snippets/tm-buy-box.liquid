{%- comment -%}
  Turf Mart default buy box: price, stock/delivery status, variant pills,
  quantity and add to cart. Takes the calculator's place on the default product
  template (sections/main-tm-product.liquid) and reuses its visual language.
    {% render 'tm-buy-box', product: product, section: section %}

  Variant data is precomputed here (prices as formatted money strings) so the
  JS never formats money itself. Files: assets/tm-buy-box.css / .js.
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign qty_min = variant.quantity_rule.min | default: 1
  assign qty_step = variant.quantity_rule.increment | default: 1
  assign qty_max = variant.quantity_rule.max
-%}

{{ 'tm-buy-box.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tm-buy-box.js' | asset_url }}" defer="defer"></script>

<tm-buy-box class="tm-buy" data-section-id="{{ section.id }}">
  <script type="application/json" data-tm-buy-config>
    {
      "productUrl": {{ product.url | json }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "options": {{ v.options | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price | money | strip_html | json }},
            "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
            "save": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | money_without_trailing_zeros | strip_html | json }}{% else %}null{% endif %},
            "sku": {{ v.sku | json }},
            "mediaId": {{ v.featured_media.id | default: 'null' }},
            "qty": { "min": {{ v.quantity_rule.min | default: 1 }}, "step": {{ v.quantity_rule.increment | default: 1 }}, "max": {{ v.quantity_rule.max | default: 'null' }} }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "routes": { "cartAdd": {{ routes.cart_add_url | append: '.js' | json }}, "cart": {{ routes.cart_url | json }} },
      "text": {
        "addToCart": {{ 'products.product.add_to_cart' | t | json }},
        "soldOut": {{ 'products.product.sold_out' | t | json }},
        "unavailable": {{ 'products.product.unavailable' | t | json }},
        "adding": "Adding…",
        "error": "Sorry, we couldn't add that to your cart. Please try again."
      }
    }
  </script>

  <div class="tm-buy__price">
    <div class="tm-buy__headline">
      <span class="tm-buy__amount" data-price>{{ variant.price | money }}</span>
      <s class="tm-buy__was" data-compare{% unless variant.compare_at_price > variant.price %} hidden{% endunless %}>
        {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money }}{%- endif -%}
      </s>
      <span class="tm-buy__save" data-save{% unless variant.compare_at_price > variant.price %} hidden{% endunless %}>
        {%- if variant.compare_at_price > variant.price -%}Save {{ variant.compare_at_price | minus: variant.price | money_without_trailing_zeros }}{%- endif -%}
      </span>
    </div>
    {%- if cart.taxes_included -%}<p class="tm-buy__tax">Incl. GST</p>{%- endif -%}
  </div>

  <div class="pdp__status">
    <div class="pdp__status-item" data-status-in{% unless variant.available %} hidden{% endunless %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#175c3f"/><path d="M7 12.5l3 3 7-7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span><b>In stock</b>{% if product.metafields.custom.stock_message != blank %}<small>{{ product.metafields.custom.stock_message }}</small>{% endif %}</span>
    </div>
    <div class="pdp__status-item" data-status-out{% if variant.available %} hidden{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#c1442a"/><path d="M8 8l8 8M16 8l-8 8" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>
      <span><b>Sold out</b><small>Contact us for availability</small></span>
    </div>
    <div class="pdp__status-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#175c3f" stroke-width="1.8" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
      <span><b>{{ section.settings.delivery_title | default: 'Australia-wide delivery' }}</b><small>{{ section.settings.delivery_text | default: '$180 per order' }}</small></span>
    </div>
  </div>

  <div class="tm-buy__card">
    {%- form 'product', product, class: 'tm-buy__form', novalidate: 'novalidate', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="tm-buy__option" data-option-group>
            <legend class="tm-buy__legend">{{ option.name }}: <span data-option-value>{{ option.selected_value }}</span></legend>
            <div class="tm-buy__values">
              {%- for value in option.values -%}
                <label class="tm-buy__value">
                  <input type="radio" name="{{ section.id }}-option-{{ option.position }}" value="{{ value | escape }}"
                    {% if option.selected_value == value %}checked{% endif %} data-option>
                  <span>{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      <div class="tm-buy__actions">
        <div class="tm-buy__qty">
          <button type="button" class="tm-buy__qty-btn" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
          <input type="number" name="quantity" value="{{ qty_min }}" min="{{ qty_min }}" step="{{ qty_step }}"{% if qty_max %} max="{{ qty_max }}"{% endif %}
            inputmode="numeric" aria-label="{{ 'products.product.quantity.label' | t }}" data-qty>
          <button type="button" class="tm-buy__qty-btn" data-qty-step="1" aria-label="Increase quantity">+</button>
        </div>
        <button type="submit" class="tm-buy__add" data-add-to-cart{% unless variant.available %} disabled{% endunless %}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1.4"/><circle cx="18" cy="21" r="1.4"/><path d="M2 3h3l2.4 12.2a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 7H6"/></svg>
          <span data-label>{%- if variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
        </button>
      </div>

      {%- if section.settings.show_dynamic_checkout -%}
        <div class="tm-buy__dynamic">{{ form | payment_button }}</div>
      {%- endif -%}

      <div class="tm-buy__error" data-error role="alert" hidden></div>
    {%- endform -%}
  </div>
</tm-buy-box>
