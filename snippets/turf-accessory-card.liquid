{%- comment -%}
  Mini accessory card for the PDP "Complete your project" row.
  Renders one product as a mini-card; the whole card links to the product page.
  Param: item — a product object.
{%- endcomment -%}
<a href="{{ item.url }}" class="mini-card">
  {%- if item.featured_image -%}
    {{ item.featured_image | image_url: width: 400 | image_tag: class: 'mini-card__media', loading: 'lazy' }}
  {%- endif -%}
  <div class="mini-card__body">
    <span class="mini-card__name">{{ item.title }}</span>
    {%- capture sqm_width -%}{% render 'tm-sqm-width', product: item %}{%- endcapture -%}
    {%- if sqm_width != blank -%}
      <span class="mini-card__price">{{ item.price | divided_by: sqm_width | round | money }}<small>/m²</small></span>
    {%- else -%}
      <span class="mini-card__price">{{ item.price | money }}</span>
    {%- endif -%}
    <span class="tm-btn tm-btn--green mini-card__btn">Add to cart</span>
  </div>
</a>
