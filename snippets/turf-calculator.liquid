{%- comment -%}
  Turf Mart materials calculator.
  Rendered from sections/main-turf-product.liquid (settings live on the
  section; `block: section` means block.settings resolves section.settings):
    {% render 'turf-calculator', product: product, block: section %}

  Data sources (all editable in Shopify admin, nothing hardcoded):
  - Turf price ........ the product's variant price, set PER LINEAL METRE of roll
                        (price per m² × roll width, e.g. $69/m² × 3.71 = $255.99)
  - Sand rate ......... product metafield  custom.sand_rate   (kg/m², decimal)
  - Roll width ........ product metafield  custom.roll_width  (m, decimal, optional)
  - Warranty .......... product metafield  custom.warranty    (single line text, optional)
  - Sand/pins/tape/glue products, pack sizes and cut rules ... block settings in the theme editor
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant

  assign roll_width = block.settings.roll_width | default: 3.71
  if product.metafields.custom.roll_width.value
    assign roll_width = product.metafields.custom.roll_width.value
  endif

  assign sand_rate = block.settings.default_sand_rate | default: 18
  if product.metafields.custom.sand_rate.value
    assign sand_rate = product.metafields.custom.sand_rate.value
  endif

  comment
    Add-on products: editor setting first, then the store's default handle
    (schema can't set a default on a product setting).
  endcomment
  assign sand_p = block.settings.sand_product
  assign pins_p = block.settings.pins_product
  assign tape_p = block.settings.tape_product
  assign glue_p = block.settings.glue_product
  assign sample_p = block.settings.sample_product
  if sand_p == blank
    assign sand_p = all_products['sand-infill-20kg-bag']
  endif
  if pins_p == blank
    assign pins_p = all_products['turf-pins-box-of-100']
  endif
  if tape_p == blank
    assign tape_p = all_products['jointing-tape-100m-roll']
  endif
  if glue_p == blank
    assign glue_p = all_products['turf-glue-20l-drum']
  endif
  if sample_p == blank
    assign sample_p = all_products['free-turf-sample']
  endif

  assign sand_v = sand_p.selected_or_first_available_variant
  assign pins_v = pins_p.selected_or_first_available_variant
  assign tape_v = tape_p.selected_or_first_available_variant
  assign glue_v = glue_p.selected_or_first_available_variant
  assign sample_v = sample_p.selected_or_first_available_variant

  assign price_per_sqm = variant.price | divided_by: roll_width | round
  assign lineal_min = block.settings.lineal_min | default: 4
  assign lineal_max = block.settings.lineal_max | default: 20
  assign lineal_step = block.settings.lineal_step | default: 2
  assign roll_lengths = block.settings.roll_pick_lengths | default: '4,6,8,10,12,14,16,20' | split: ','

  assign compare_per_sqm = variant.compare_at_price | divided_by: roll_width | round
  assign save_per_sqm = compare_per_sqm | minus: price_per_sqm
-%}

{{ 'turf-calculator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'turf-calculator.js' | asset_url }}" defer="defer"></script>

<turf-calculator class="turf-calc" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
  <script type="application/json" data-turf-config>
    {
      "rollWidth": {{ roll_width }},
      "sandRate": {{ sand_rate }},
      "lineal": { "min": {{ lineal_min }}, "max": {{ lineal_max }}, "step": {{ lineal_step }} },
      "turf": {
        "variantId": {{ variant.id }},
        "pricePerMetre": {{ variant.price }},
        "available": {{ variant.available | json }},
        "title": {{ product.vendor | append: ' ' | append: product.title | json }}
      },
      "sand": { "variantId": {{ sand_v.id | default: 'null' }}, "price": {{ sand_v.price | default: 0 }}, "bagKg": {{ block.settings.sand_bag_kg | default: 20 }} },
      "pins": { "variantId": {{ pins_v.id | default: 'null' }}, "price": {{ pins_v.price | default: 0 }}, "perSqm": {{ block.settings.pins_per_sqm | default: 5 }}, "perBox": {{ block.settings.pins_per_box | default: 100 }} },
      "tape": { "variantId": {{ tape_v.id | default: 'null' }}, "price": {{ tape_v.price | default: 0 }}, "rollM": {{ block.settings.tape_roll_m | default: 100 }} },
      "glue": { "variantId": {{ glue_v.id | default: 'null' }}, "price": {{ glue_v.price | default: 0 }}, "mPerL": {{ block.settings.glue_m_per_l | default: 5 }}, "drumL": {{ block.settings.glue_drum_l | default: 20 }} },
      "sampleVariantId": {{ sample_v.id | default: 'null' }},
      "payLaterInstalments": {{ block.settings.pay_later_instalments | default: 0 }},
      "moneyFormat": {{ shop.money_format | json }},
      "routes": { "cartAdd": {{ routes.cart_add_url | append: '.js' | json }}, "cart": {{ routes.cart_url | json }} },
      "text": {
        "prompt": "Enter your area above and we'll work out your rolls and materials.",
        "empty": "No materials yet — enter an area to see your turf, sand, pins, tape and glue.",
        "buybarPrompt": "Enter your area to price your order",
        "addToCart": {{ 'products.product.add_to_cart' | t | json }},
        "adding": "Adding…",
        "error": "Sorry, we couldn't add that to your cart. Please try again."
      }
    }
  </script>

  <div class="turf-calc__price">
    <div class="turf-calc__headline">
      <span class="turf-calc__per-sqm">{{ price_per_sqm | money }}<span class="turf-calc__unit">/m²</span></span>
      {%- if variant.compare_at_price > variant.price -%}
        <s class="turf-calc__was">{{ compare_per_sqm | money }}/m²</s>
        <span class="turf-calc__save">Save {{ save_per_sqm | money_without_trailing_zeros }}</span>
      {%- endif -%}
    </div>
    <p class="turf-calc__gst">{{ roll_width }} m wide · sold by the lineal metre{% if cart.taxes_included %} · incl. GST{% endif %}</p>
  </div>

  <div class="pdp__status">
    <div class="pdp__status-item">
      {%- if variant.available -%}
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#175c3f"/><path d="M7 12.5l3 3 7-7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><b>In stock</b>{% if product.metafields.custom.stock_message != blank %}<small>{{ product.metafields.custom.stock_message }}</small>{% endif %}</span>
      {%- else -%}
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#c1442a"/><path d="M8 8l8 8M16 8l-8 8" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>
        <span><b>Sold out</b><small>Contact us for availability</small></span>
      {%- endif -%}
    </div>
    <div class="pdp__status-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#175c3f" stroke-width="1.8" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
      <span><b>{{ block.settings.delivery_title | default: 'Australia-wide delivery' }}</b><small>{{ block.settings.delivery_text | default: '$180 per order, cut to size' }}</small></span>
    </div>
  </div>

  <div class="turf-calc__card">
    <h2 class="turf-calc__title">How much do you need?</h2>

    <div class="turf-calc__tabs" role="tablist">
      <button type="button" role="tab" class="turf-calc__tab" data-calc-tab="area" aria-selected="true">Area (m²)</button>
      <button type="button" role="tab" class="turf-calc__tab" data-calc-tab="dims" aria-selected="false">Length × width</button>
      <button type="button" role="tab" class="turf-calc__tab" data-calc-tab="roll" aria-selected="false">Select a roll</button>
    </div>

    <div class="turf-calc__panel" data-calc-panel="area">
      <label class="turf-calc__field">
        <span>Area required (m²)</span>
        <input type="number" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 40" data-input="area">
      </label>
    </div>
    <div class="turf-calc__panel" data-calc-panel="dims" hidden>
      <div class="turf-calc__field-row">
        <label class="turf-calc__field">
          <span>Length (m)</span>
          <input type="number" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 8" data-input="length">
        </label>
        <label class="turf-calc__field">
          <span>Width (m)</span>
          <input type="number" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 5" data-input="width">
        </label>
      </div>
    </div>
    <div class="turf-calc__panel" data-calc-panel="roll" hidden>
      <label class="turf-calc__field">
        <span>Select SQM required</span>
        <select data-input="roll">
          {%- for len in roll_lengths -%}
            {%- assign l = len | strip | plus: 0 -%}
            {%- if l > 0 -%}
              {%- liquid
                assign sqm_cents = l | times: roll_width | times: 100 | round
                assign sqm_whole = sqm_cents | divided_by: 100
                assign sqm_frac = sqm_cents | modulo: 100
                if sqm_frac < 10
                  assign sqm_frac = sqm_frac | prepend: '0'
                endif
              -%}
              <option value="{{ l }}">{{ l }} Metre Roll ({{ sqm_whole }}.{{ sqm_frac }} SQM)</option>
            {%- endif -%}
          {%- endfor -%}
        </select>
      </label>
    </div>

    <div class="turf-calc__message" data-message aria-live="polite">
      Enter your area above and we'll work out your rolls and materials.
    </div>

    <div class="turf-calc__divider"></div>
    <div class="turf-calc__materials" data-materials></div>

    <div class="turf-calc__total-row">
      <div>
        <div class="turf-calc__total-label">Order total</div>
        <div class="turf-calc__paylater" data-paylater></div>
      </div>
      <div class="turf-calc__total" data-total>{{ 0 | money }}</div>
    </div>
    <div class="turf-calc__note" data-note></div>
    <div class="turf-calc__error" data-error role="alert" hidden></div>

    <div class="turf-calc__actions">
      <button type="button" class="turf-calc__buy turf-calc__buy--inline" data-add-to-cart disabled>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1.4"/><circle cx="18" cy="21" r="1.4"/><path d="M2 3h3l2.4 12.2a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 7H6"/></svg>
        <span data-label>{%- if variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
      </button>
      {%- if sample_v -%}
        <button type="button" class="turf-calc__sample" data-add-sample>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>
          <span>Order free sample</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</turf-calculator>

<div class="turf-buybar" id="TurfBuyBar-{{ block.id }}" hidden>
  <div>
    <div class="turf-buybar__total" data-buybar-total>{{ 0 | money }}</div>
    <div class="turf-buybar__sub" data-buybar-sub>Enter your area to price your order</div>
  </div>
  <button type="button" class="turf-calc__buy" data-add-to-cart disabled>{{ 'products.product.add_to_cart' | t }}</button>
</div>
