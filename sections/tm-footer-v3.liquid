{{ 'tm-footer-v3.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shop_menu = section.settings.shop_menu
  assign help_menu = section.settings.help_menu
  assign trade_menu = section.settings.trade_menu
  assign use_shop_menu = false
  if shop_menu != blank and shop_menu.links.size > 0
    assign use_shop_menu = true
  endif
  assign use_help_menu = false
  if help_menu != blank and help_menu.links.size > 0
    assign use_help_menu = true
  endif
  assign use_trade_menu = false
  if trade_menu != blank and trade_menu.links.size > 0
    assign use_trade_menu = true
  endif
  assign email_id = 'tm-footer-v3-email-' | append: section.id

  assign logo_image = section.settings.logo
  if logo_image == blank
    assign logo_image = settings.logo
  endif
-%}

<footer class="tm-footer-v3">
  <div class="tm-footer-v3__row">
    <div class="tm-footer-v3__brand">
      <a href="{{ routes.root_url }}" class="tm-footer-v3__logo" aria-label="{{ shop.name | escape }}" style="--logo-w: {{ section.settings.logo_width }}px;">
        {%- if logo_image != blank -%}
          {{ logo_image | image_url: width: 600 | image_tag: alt: '', loading: 'lazy', widths: '200, 300, 400, 600', sizes: section.settings.logo_width | append: 'px' }}
        {%- else -%}
          <img src="{{ 'logo.png' | asset_url }}" alt="" width="700" height="237" loading="lazy">
        {%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="tm-footer-v3__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
    </div>

    <div class="tm-footer-v3__cols">
      <nav class="tm-footer-v3__col" aria-label="Shop">
        <span class="tm-footer-v3__col-heading">Shop</span>
        {%- if use_shop_menu -%}
          {%- for link in shop_menu.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.column == 'shop' -%}
              <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </nav>
      <nav class="tm-footer-v3__col" aria-label="Help">
        <span class="tm-footer-v3__col-heading">Help</span>
        {%- if use_help_menu -%}
          {%- for link in help_menu.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.column == 'help' -%}
              <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </nav>
      <nav class="tm-footer-v3__col" aria-label="Trade">
        <span class="tm-footer-v3__col-heading">Trade</span>
        {%- if use_trade_menu -%}
          {%- for link in trade_menu.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.column == 'trade' -%}
              <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </nav>
    </div>

    <div class="tm-footer-v3__newsletter">
      {%- form 'customer', class: 'tm-footer-v3__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="tm-footer-v3__heading" for="{{ email_id }}">{{ section.settings.newsletter_heading | escape }}</label>
        <div class="tm-footer-v3__form-row">
          <input
            id="{{ email_id }}"
            class="tm-footer-v3__input"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.newsletter_placeholder | escape }}"
            autocomplete="email"
            required
          >
          <div class="tm-footer-v3__actions">
            <button type="submit" class="tm-footer-v3__signup">{{ section.settings.newsletter_button_label | escape }}</button>
            <button type="submit" class="tm-footer-v3__arrow" aria-label="{{ section.settings.newsletter_button_label | escape }}">
              <svg viewBox="0 0 22 22" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M4.58333 11H17.4167M11.9167 16.5L17.4167 11L11.9167 5.5" stroke="currentColor" stroke-width="1.83333"/>
              </svg>
            </button>
          </div>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="tm-footer-v3__msg" role="status">Thanks for signing up.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="tm-footer-v3__msg tm-footer-v3__msg--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  {%- if section.settings.show_wordmark -%}
    {%- if section.settings.wordmark_type == 'image' and section.settings.wordmark_image != blank -%}
      <div class="tm-footer-v3__wordmark tm-footer-v3__wordmark--image" style="--wordmark-max: {{ section.settings.wordmark_image_width }}px;" aria-hidden="true">
        {{ section.settings.wordmark_image | image_url: width: 2560 | image_tag: alt: '', loading: 'lazy', widths: '640, 960, 1280, 1920, 2560', sizes: '(min-width: 1441px) 1280px, 90vw' }}
      </div>
    {%- else -%}
      <div class="tm-footer-v3__wordmark" aria-hidden="true">{{ section.settings.wordmark | escape }}</div>
    {%- endif -%}
  {%- endif -%}

  <div class="tm-footer-v3__bottom">
    <div class="tm-footer-v3__copyright">{{ section.settings.copyright | escape }}</div>
  </div>
</footer>

{% schema %}
{
  "name": "Turf Mart — Footer v3",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo",
      "info": "Use a light/white version for the dark background. Falls back to the theme logo, then the default Turf Mart logo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Text under logo",
      "info": "Optional short line."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join our mailing list"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Newsletter button label",
      "default": "Sign up"
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show giant wordmark",
      "default": false
    },
    {
      "type": "select",
      "id": "wordmark_type",
      "label": "Wordmark style",
      "options": [
        { "value": "text", "label": "Text" },
        { "value": "image", "label": "Image" }
      ],
      "default": "text",
      "info": "The large brand name above the copyright line."
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark text",
      "default": "Turf Mart",
      "info": "Used when the style is Text, or when Image is chosen but no image is set."
    },
    {
      "type": "image_picker",
      "id": "wordmark_image",
      "label": "Wordmark image",
      "info": "Used when the style is Image. A wide transparent PNG or SVG works best."
    },
    {
      "type": "range",
      "id": "wordmark_image_width",
      "label": "Wordmark image max width",
      "min": 200,
      "max": 1280,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "© 2026 Turf Mart, All rights Reserved"
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu (source)"
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "Help menu (source)"
    },
    {
      "type": "link_list",
      "id": "trade_menu",
      "label": "Trade menu (source)"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Footer link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Delivery"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "options": [
            {
              "value": "shop",
              "label": "Shop"
            },
            {
              "value": "help",
              "label": "Help"
            },
            {
              "value": "trade",
              "label": "Trade"
            }
          ],
          "default": "shop"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Turf Mart — Footer v3",
      "blocks": [
        {
          "type": "link",
          "settings": { "label": "Pet Turf", "column": "shop" }
        },
        {
          "type": "link",
          "settings": { "label": "Pool Turf", "column": "shop" }
        },
        {
          "type": "link",
          "settings": { "label": "Landscape Turf", "column": "shop" }
        },
        {
          "type": "link",
          "settings": { "label": "Commercial Turf", "column": "shop" }
        },
        {
          "type": "link",
          "settings": { "label": "Sports Turf", "column": "shop" }
        },
        {
          "type": "link",
          "settings": { "label": "Delivery", "column": "help" }
        },
        {
          "type": "link",
          "settings": { "label": "Returns", "column": "help" }
        },
        {
          "type": "link",
          "settings": { "label": "Install guides", "column": "help" }
        },
        {
          "type": "link",
          "settings": { "label": "Contact", "column": "help" }
        },
        {
          "type": "link",
          "settings": { "label": "Trade accounts", "column": "trade" }
        },
        {
          "type": "link",
          "settings": { "label": "Bulk orders", "column": "trade" }
        }
      ]
    }
  ]
}
{% endschema %}
