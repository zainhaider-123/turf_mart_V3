{{ 'homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tm-homepage.js' | asset_url }}" defer></script>

{%- liquid
  assign fallbacks = 'pet-turf-dog,pool-turf,landscape-turf,commercial-turf,sports-turf-putting-green,product-classic-35' | split: ','
-%}

<section class="tm-section tm-section--reviews tm-scope" aria-labelledby="rev-h">
  <div class="tm-container tm-stack">
    <div class="reviews__head">
      <h2 id="rev-h" class="tm-section-title">{{ section.settings.heading | escape }}</h2>
      <div class="reviews__tools">
        <div class="reviews__summary">
          <span class="tm-stars tm-stars--lg" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          <span>
            <b>{{ section.settings.rating | escape }}</b>
            {%- if section.settings.rating_suffix != blank -%}
              <span class="d-only"> {{ section.settings.rating_suffix | escape }}</span>
            {%- endif -%}
            ·
            <a href="{{ section.settings.reviews_url | default: '#' }}" class="reviews__count">{{ section.settings.reviews_label | escape }}</a>
          </span>
        </div>
        {%- if section.settings.show_arrows -%}
          <div class="carousel-arrows d-only">
            <button type="button" class="carousel-arrow" aria-label="Previous reviews" aria-controls="reviews-track" data-tm-carousel-prev>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            </button>
            <button type="button" class="carousel-arrow" aria-label="Next reviews" aria-controls="reviews-track" data-tm-carousel-next>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="reviews__track" id="reviews-track" role="region" aria-roledescription="carousel" aria-label="Customer reviews" tabindex="0" data-tm-carousel-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign fallback = fallbacks[forloop.index0] | default: 'product-classic-35'
          if block.settings.image != blank
            assign review_src = block.settings.image | image_url: width: 640
            assign review_alt = block.settings.image.alt | default: block.settings.quote
            assign review_width = block.settings.image.width
            assign review_height = block.settings.image.height
          else
            assign review_src = fallback | append: '.jpg' | asset_url
            assign review_alt = 'Customer photo'
            assign review_width = 306
            assign review_height = 180
          endif
          assign star_count = block.settings.rating | plus: 0
        -%}
        <figure class="review-card" {{ block.shopify_attributes }}>
          <img src="{{ review_src }}" alt="{{ review_alt | escape }}" width="{{ review_width }}" height="{{ review_height }}" loading="lazy">
          <div class="review-card__body">
            <span class="tm-stars" role="img" aria-label="{{ star_count }} out of 5 stars">
              {%- for i in (1..star_count) -%}<i></i>{%- endfor -%}
            </span>
            <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
            <figcaption>
              <span class="review-card__who"><b>{{ block.settings.author | escape }}</b><span>{{ block.settings.location | escape }}</span></span>
              <span class="tm-tag">{{ block.settings.tag | escape }}</span>
            </figcaption>
          </div>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_suffix",
      "label": "Rating suffix",
      "default": "out of 5"
    },
    {
      "type": "text",
      "id": "reviews_label",
      "label": "Reviews link label",
      "default": "1,200+ reviews"
    },
    {
      "type": "url",
      "id": "reviews_url",
      "label": "Reviews link"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Rating",
          "options": [
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "3",
              "label": "3"
            },
            {
              "value": "4",
              "label": "4"
            },
            {
              "value": "5",
              "label": "5"
            }
          ],
          "default": "5"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The dogs are on it all day and it still looks brand new. Hosing it down takes two minutes."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah T."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Brisbane, QLD"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Pet Turf"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews carousel"
    }
  ]
}
{% endschema %}
