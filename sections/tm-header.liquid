{{ 'homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tm-homepage.js' | asset_url }}" defer></script>

{%- liquid
  assign logo = section.settings.logo
-%}
<div class="tm-site-top tm-scope">
  <div class="tm-announcement">
    {{ section.settings.announcement_text | escape }}{% if section.settings.announcement_suffix != blank %}<span class="d-only">{{ section.settings.announcement_suffix | escape }}</span>{% endif %}
  </div>

  <header class="tm-header">
    <div class="tm-container tm-header__inner">
      <button type="button" class="tm-icon-btn tm-header__menu m-only" aria-label="Menu" aria-controls="tm-menu-drawer" aria-expanded="false" data-tm-menu-open>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>

      <a href="{{ routes.root_url }}" class="tm-header__logo" aria-label="{{ shop.name | escape }}">
        {%- if logo != blank -%}
          <img src="{{ logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="700" height="237">
        {%- else -%}
          <img src="{{ 'logo.png' | asset_url }}" alt="Turf Mart" width="700" height="237">
        {%- endif -%}
      </a>

      <form role="search" class="tm-search tm-search--desktop d-only" action="{{ routes.search_url }}" method="get">
        <label for="tm-search-desktop" class="visually-hidden">Search Turf Mart</label>
        <span class="tm-search__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        </span>
        <input id="tm-search-desktop" type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}">
        <button type="submit" class="tm-search__submit">{{ section.settings.search_submit_label | escape }}</button>
      </form>

      <div class="tm-header__actions d-only">
        {%- if section.settings.show_account -%}
          <a href="{{ routes.account_url }}" class="tm-icon-btn" aria-label="Account">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.show_cart -%}
          <a href="{{ routes.cart_url }}" class="tm-icon-btn tm-header__cart" aria-label="Cart, {{ cart.item_count }} items">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="21" r="1.4"/><circle cx="18" cy="21" r="1.4"/><path d="M2 3h3l2.4 12.2a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 7H6"/></svg>
            <span class="tm-cart-count">{{ cart.item_count }}</span>
          </a>
        {%- endif -%}
      </div>

      <button type="button" class="tm-icon-btn tm-header__search-toggle m-only" aria-label="Open search" aria-controls="tm-mobile-search" aria-expanded="false" data-tm-search-toggle>
        <svg class="tm-i-search" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <svg class="tm-i-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <form role="search" id="tm-mobile-search" class="tm-search tm-search--mobile m-only" action="{{ routes.search_url }}" method="get" hidden>
      <label for="tm-search-mobile" class="visually-hidden">Search Turf Mart</label>
      <input id="tm-search-mobile" type="search" name="q" placeholder="{{ section.settings.search_placeholder_mobile | escape }}">
      <button type="submit" class="tm-search__submit" aria-label="Search">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
    </form>
  </header>

  <nav class="tm-main-nav d-only" aria-label="Main">
    <div class="tm-container tm-main-nav__inner">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
      {%- endfor -%}
    </div>
  </nav>
</div>

<div class="tm-drawer" id="tm-menu-drawer" hidden>
  <div class="tm-drawer__backdrop" data-tm-menu-close></div>
  <nav class="tm-drawer__panel" aria-label="Menu">
    <div class="tm-drawer__head">
      {%- if logo != blank -%}
        <img src="{{ logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="700" height="237">
      {%- else -%}
        <img src="{{ 'logo.png' | asset_url }}" alt="Turf Mart" width="700" height="237">
      {%- endif -%}
      <button type="button" class="tm-icon-btn" aria-label="Close menu" data-tm-menu-close>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label | escape }}</a>
    {%- endfor -%}
  </nav>
</div>

{% schema %}
{
  "name": "Turf Mart header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Australia-wide delivery · Free samples"
    },
    {
      "type": "text",
      "id": "announcement_suffix",
      "label": "Announcement suffix (desktop only)",
      "default": " · Trade accounts available"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder (desktop)",
      "default": "Search turf, brands, installation products…"
    },
    {
      "type": "text",
      "id": "search_placeholder_mobile",
      "label": "Search placeholder (mobile)",
      "default": "Search turf, brands, accessories"
    },
    {
      "type": "text",
      "id": "search_submit_label",
      "label": "Search button label",
      "default": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation link",
      "limit": 9,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Navigation link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Turf Mart header"
    }
  ]
}
{% endschema %}
