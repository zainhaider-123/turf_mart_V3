{{ 'homepage.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.image != blank
    assign feature_src = section.settings.image | image_url: width: 1600
    assign feature_alt = section.settings.image.alt | default: section.settings.heading
    assign feature_width = section.settings.image.width
    assign feature_height = section.settings.image.height
  else
    assign feature_src = 'pet-turf-dog.jpg' | asset_url
    assign feature_alt = 'Golden retriever lying on artificial turf'
    assign feature_width = 306
    assign feature_height = 180
  endif
-%}

<section class="tm-section tm-section--pet tm-scope" aria-labelledby="pet-h">
  <div class="tm-container">
    <div class="feature">
      <img class="feature__img" src="{{ feature_src }}" alt="{{ feature_alt | escape }}" width="{{ feature_width }}" height="{{ feature_height }}" loading="lazy">
      <div class="feature__shade"></div>
      <div class="feature__content">
        <span class="tm-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2 id="pet-h" class="feature__title">{{ section.settings.heading | escape }}</h2>
        <p class="feature__text">
          {{- section.settings.text | escape -}}
          {%- if section.settings.text_desktop_extra != blank -%}
            <span class="d-only">{{ section.settings.text_desktop_extra | escape }}</span>
          {%- endif -%}
          .
        </p>
        <div class="feature__actions">
          <a href="{{ section.settings.button_1_url | default: '#' }}" class="tm-btn tm-btn--yellow">{{ section.settings.button_1_label | escape }}</a>
          <a href="{{ section.settings.button_2_url | default: '#' }}" class="tm-btn tm-btn--outline-light">{{ section.settings.button_2_label | escape }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Pet Turf"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for dogs. Easy to hose."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tough, quick-draining turf made for busy backyards. No mud, no bare patches"
    },
    {
      "type": "text",
      "id": "text_desktop_extra",
      "label": "Text (desktop only ending)",
      "default": ", no muddy paws through the house"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "First button label",
      "default": "Shop pet turf"
    },
    {
      "type": "url",
      "id": "button_1_url",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "Get a free sample"
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "Second button link"
    }
  ],
  "presets": [
    {
      "name": "Feature banner"
    }
  ]
}
{% endschema %}
