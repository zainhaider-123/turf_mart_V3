{{ 'homepage.css' | asset_url | stylesheet_tag }}
{{ 'tm-promos.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Turf Mart homepage promo tiles.

  Blocks:
  - samples   Free samples tile. "Sample picker" layout renders the shared
              tm-sample-picker snippet (same rules and cart bundle as the Free
              Sample page and the product-page button). "Link" layout is the
              original image + button tile.
  - estimate  Quick turf estimate (turf type + area or length × width), using
              the approved calculator logic in assets/turf-calculator.js. The
              button goes to the chosen turf type's collection.
  - trade     Trade promo (kept for later; disable the block to hide it).
  - tile      Small icon tile (yellow or white).
{%- endcomment -%}

<section class="tm-section tm-section--promos tm-scope" aria-label="{{ section.settings.aria_label | default: 'Shop with Turf Mart' | escape }}">
  <div class="tm-container promos">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'samples' -%}
          {%- liquid
            if block.settings.image != blank
              assign promo_src = block.settings.image | image_url: width: 900
              assign promo_alt = block.settings.image.alt | default: block.settings.title
              assign promo_width = block.settings.image.width
              assign promo_height = block.settings.image.height
            else
              assign promo_src = 'turf-closeup-blades.jpg' | asset_url
              assign promo_alt = 'Close-up of turf blades'
              assign promo_width = 278
              assign promo_height = 138
            endif

            assign sample_p = block.settings.sample_product
            if sample_p == blank
              assign sample_p = all_products['free-turf-sample']
            endif
            assign sample_v = sample_p.selected_or_first_available_variant
            assign sample_list = block.settings.collection
            if sample_list == blank
              assign sample_list = collections['all']
            endif
            assign all_url = block.settings.url | default: sample_p.url | default: '#'
          -%}

          {%- if block.settings.layout == 'picker' and sample_v -%}
            <div class="promo promo--samples promo--picker" id="free-samples" {{ block.shopify_attributes }}>
              <img class="promo__img tm-pick-hero" src="{{ promo_src }}" alt="{{ promo_alt | escape }}" width="{{ promo_width }}" height="{{ promo_height }}" loading="lazy">
              <div class="promo__body tm-pick">
                <span class="tm-pill">{{ block.settings.pill | escape }}</span>
                <h2 class="promo__title">{{ block.settings.title | escape }}</h2>
                {%- if block.settings.text != blank -%}
                  <p class="promo__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}

                {% render 'tm-sample-counter' %}

                {% render 'tm-sample-picker',
                  sample_variant: sample_v,
                  sample_product: sample_p,
                  collection: sample_list,
                  product_type: block.settings.product_type,
                  limit: block.settings.products_to_show,
                  max: block.settings.max_samples,
                  stay_on_page: true
                %}

                <a href="{{ all_url }}" class="tm-pick__all">{{ block.settings.all_label | escape }}
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </div>
            </div>
          {%- else -%}
            <a href="{{ all_url }}" class="promo promo--samples" {{ block.shopify_attributes }}>
              <img class="promo__img" src="{{ promo_src }}" alt="{{ promo_alt | escape }}" width="{{ promo_width }}" height="{{ promo_height }}" loading="lazy">
              <div class="promo__body">
                <span class="tm-pill">{{ block.settings.pill | escape }}</span>
                <span class="promo__title">{{ block.settings.title | escape }}</span>
                <span class="promo__text d-only">{{ block.settings.text | escape }}</span>
                <span class="tm-btn tm-btn--yellow">{{ block.settings.button_label | escape }}</span>
              </div>
            </a>
          {%- endif -%}

        {%- when 'estimate' -%}
          {%- liquid
            assign roll_width = block.settings.roll_width | default: 3.71
            assign default_index = block.settings.default_type | plus: 0
            assign type_count = 0
          -%}
          <tm-turf-estimate class="promo promo--estimate" id="quick-estimate" {{ block.shopify_attributes }}>
            <script type="application/json" data-tm-estimate-config>
              {
                "rollWidth": {{ roll_width }},
                "lineal": { "min": {{ block.settings.lineal_min | default: 4 }}, "max": {{ block.settings.lineal_max | default: 20 }}, "step": {{ block.settings.lineal_step | default: 2 }} },
                "moneyFormat": {{ shop.money_format | json }},
                "buttonPrefix": {{ block.settings.button_prefix | default: 'Shop' | json }},
                "text": {
                  "hintArea": {{ block.settings.hint_area | json }},
                  "hintDims": {{ block.settings.hint_dims | json }},
                  "yourArea": {{ block.settings.your_area_label | json }},
                  "coverage": {{ block.settings.coverage_label | json }}
                }
              }
            </script>
            <div class="promo__body">
              <span class="tm-pill tm-pill--dark">{{ block.settings.pill | escape }}</span>
              <h2 class="promo__title">{{ block.settings.title | escape }}</h2>
              {%- if block.settings.text != blank -%}
                <p class="promo__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>

            <form class="tm-est" action="{{ routes.all_products_collection_url }}" data-est-form>
              <div class="tm-est__modes" role="tablist" aria-label="How to measure">
                <button type="button" role="tab" class="tm-est__mode" aria-selected="true" data-est-mode="area">Area (m²)</button>
                <button type="button" role="tab" class="tm-est__mode" aria-selected="false" data-est-mode="dims">Length × width</button>
              </div>
              <div class="tm-est__fields">
                <label class="tm-est__field tm-est__field--wide">
                  <span>Turf type</span>
                  <select name="type" data-est-type>
                    {%- for i in (1..6) -%}
                      {%- liquid
                        assign label_key = 'type_' | append: i | append: '_label'
                        assign coll_key = 'type_' | append: i | append: '_collection'
                        assign price_key = 'type_' | append: i | append: '_price'
                        assign t_label = block.settings[label_key]
                        assign t_coll = block.settings[coll_key]
                        if t_label == blank or t_coll == blank
                          continue
                        endif
                        assign type_count = type_count | plus: 1
                        assign t_price = block.settings[price_key]
                        if t_price != blank
                          assign t_from = t_price | times: 100
                        else
                          assign t_from = t_coll.price_min | divided_by: roll_width
                        endif
                      -%}
                      <option value="{{ t_coll.handle }}" data-url="{{ t_coll.url }}" data-from="{{ t_from | round }}"{% if i == default_index %} selected{% endif %}>{{ t_label | escape }}</option>
                    {%- endfor -%}
                  </select>
                </label>
                <label class="tm-est__field tm-est__field--wide" data-est-show="area">
                  <span>Area (m²)</span>
                  <input type="number" name="area" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 40" data-est-area>
                </label>
                <label class="tm-est__field" data-est-show="dims" hidden>
                  <span>Length (m)</span>
                  <input type="number" name="length" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 8" data-est-length>
                </label>
                <label class="tm-est__field" data-est-show="dims" hidden>
                  <span>Width (m)</span>
                  <input type="number" name="width" inputmode="decimal" min="0" step="0.1" placeholder="e.g. 5" data-est-width>
                </label>
              </div>
              <div class="tm-est__result" aria-live="polite" data-est-result>
                <span class="tm-est__hint">{{ block.settings.hint_area | escape }}</span>
              </div>
              <a href="{{ routes.all_products_collection_url }}" class="tm-btn tm-btn--yellow tm-est__cta" data-est-cta>
                <span data-est-cta-label>{{ block.settings.button_prefix | default: 'Shop' | escape }}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </form>
            {%- if type_count == 0 and request.design_mode -%}
              <p class="tm-est__setup">Add at least one turf type (label + collection) in this block's settings.</p>
            {%- endif -%}
          </tm-turf-estimate>
          <script src="{{ 'turf-calculator.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'tm-estimate.js' | asset_url }}" defer="defer"></script>

        {%- when 'trade' -%}
          {%- liquid
            if block.settings.image != blank
              assign promo_src = block.settings.image | image_url: width: 640
              assign promo_alt = block.settings.image.alt | default: block.settings.title
              assign promo_width = block.settings.image.width
              assign promo_height = block.settings.image.height
            else
              assign promo_src = 'commercial-turf.jpg' | asset_url
              assign promo_alt = 'Turf outside a commercial building'
              assign promo_width = 306
              assign promo_height = 180
            endif
          -%}
          <a href="{{ block.settings.url | default: '#' }}" class="promo promo--trade" {{ block.shopify_attributes }}>
            <div class="promo__body">
              <span class="tm-pill tm-pill--dark">{{ block.settings.pill | escape }}</span>
              <span class="promo__title">{{ block.settings.title | escape }}</span>
              <span class="promo__text d-only">{{ block.settings.text | escape }}</span>
              <span class="tm-btn tm-btn--yellow d-only">{{ block.settings.button_label | escape }}</span>
              <span class="tm-text-link m-only">{{ block.settings.button_label | escape }}
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
            <img class="promo__img d-only" src="{{ promo_src }}" alt="{{ promo_alt | escape }}" width="{{ promo_width }}" height="{{ promo_height }}" loading="lazy">
          </a>

        {%- when 'tile' -%}
          <a
            href="{{ block.settings.url | default: '#' }}"
            class="promo promo--tile{% if block.settings.style == 'yellow' %} promo--measure{% else %} promo--diy{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="promo__icon">
              {%- case block.settings.icon -%}
                {%- when 'diy' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.5 6.5a4 4 0 0 0-5.3 5.3L3 18l3 3 6.2-6.2a4 4 0 0 0 5.3-5.3l-2.6 2.6-2.4-.6-.6-2.4z"/></svg>
                {%- when 'chat' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16v11H8l-4 4z"/><path d="M8 9.5h8M8 12.5h5"/></svg>
                {%- when 'kit' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 17L17 3l4 4L7 21H3z"/><path d="M13 7l2 2M10 10l2 2M7 13l2 2"/></svg>
              {%- endcase -%}
            </span>
            <span class="promo__tile-text">
              <span class="promo__tile-title">{{ block.settings.title | escape }}</span>
              <span class="promo__tile-sub">
                <span class="d-only">{{ block.settings.sub_desktop | escape }}</span>
                <span class="m-only">{{ block.settings.sub_mobile | escape }}</span>
              </span>
            </span>
          </a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Promo tiles",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Section label (screen readers)", "default": "Shop with Turf Mart" }
  ],
  "blocks": [
    {
      "type": "samples",
      "name": "Samples promo",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "layout", "label": "Layout", "options": [
          { "value": "picker", "label": "Sample picker" },
          { "value": "link", "label": "Image and button" }
        ], "default": "picker" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "pill", "label": "Pill label", "default": "Free samples" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feel it before you buy." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pick up to 5 turf samples and we'll post them to you." },
        { "type": "url", "id": "url", "label": "Free samples page link", "info": "\"See all samples\" link and the button link in the Image and button layout. Leave blank to use the free sample product." },
        { "type": "header", "content": "Image and button layout" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Order free samples" },
        { "type": "header", "content": "Sample picker layout" },
        { "type": "product", "id": "sample_product", "label": "Free sample product", "info": "Leave blank to use free-turf-sample." },
        { "type": "collection", "id": "collection", "label": "Turfs to show", "info": "E.g. a \"Popular samples\" collection. Leave blank to use all products." },
        { "type": "text", "id": "product_type", "label": "Product type", "default": "Synthetic turf", "info": "Only products of this exact type are listed. Leave blank to list every type." },
        { "type": "range", "id": "products_to_show", "label": "Turfs to show", "min": 2, "max": 12, "step": 1, "default": 6 },
        { "type": "range", "id": "max_samples", "label": "Free samples per order", "min": 1, "max": 10, "step": 1, "default": 5, "info": "Keep the same as the Free sample page setting." },
        { "type": "text", "id": "all_label", "label": "\"See all\" link label", "default": "See all samples" }
      ]
    },
    {
      "type": "estimate",
      "name": "Turf calculator",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "pill", "label": "Pill label", "default": "Turf calculator" },
        { "type": "text", "id": "title", "label": "Title", "default": "How much turf do I need?" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Enter your area, or just the length and width, for an instant roll estimate. Then pick your turf for a full quote with sand, pins, tape and glue." },
        { "type": "text", "id": "button_prefix", "label": "Button text before turf type", "default": "Shop", "info": "Shows as e.g. \"Shop landscape turf\"." },
        { "type": "header", "content": "Turf types", "info": "Each type needs a label and a collection. The \"from\" price is the collection's cheapest product per m², unless you enter a price." },
        { "type": "text", "id": "type_1_label", "label": "Type 1 label", "default": "Pet turf" },
        { "type": "collection", "id": "type_1_collection", "label": "Type 1 collection" },
        { "type": "number", "id": "type_1_price", "label": "Type 1 from price per m² (optional)" },
        { "type": "text", "id": "type_2_label", "label": "Type 2 label", "default": "Pool turf" },
        { "type": "collection", "id": "type_2_collection", "label": "Type 2 collection" },
        { "type": "number", "id": "type_2_price", "label": "Type 2 from price per m² (optional)" },
        { "type": "text", "id": "type_3_label", "label": "Type 3 label", "default": "Landscape turf" },
        { "type": "collection", "id": "type_3_collection", "label": "Type 3 collection" },
        { "type": "number", "id": "type_3_price", "label": "Type 3 from price per m² (optional)" },
        { "type": "text", "id": "type_4_label", "label": "Type 4 label", "default": "Commercial turf" },
        { "type": "collection", "id": "type_4_collection", "label": "Type 4 collection" },
        { "type": "number", "id": "type_4_price", "label": "Type 4 from price per m² (optional)" },
        { "type": "text", "id": "type_5_label", "label": "Type 5 label", "default": "Sports turf" },
        { "type": "collection", "id": "type_5_collection", "label": "Type 5 collection" },
        { "type": "number", "id": "type_5_price", "label": "Type 5 from price per m² (optional)" },
        { "type": "text", "id": "type_6_label", "label": "Type 6 label", "default": "Eco-friendly turf" },
        { "type": "collection", "id": "type_6_collection", "label": "Type 6 collection" },
        { "type": "number", "id": "type_6_price", "label": "Type 6 from price per m² (optional)" },
        { "type": "range", "id": "default_type", "label": "Selected type on load", "min": 1, "max": 6, "step": 1, "default": 3 },
        { "type": "header", "content": "Roll rules", "info": "Keep the same as the product-page calculator." },
        { "type": "number", "id": "roll_width", "label": "Roll width (m)", "info": "Leave blank for 3.71 m." },
        { "type": "number", "id": "lineal_min", "label": "Minimum cut (m)", "default": 4 },
        { "type": "number", "id": "lineal_max", "label": "Maximum roll length (m)", "default": 20 },
        { "type": "number", "id": "lineal_step", "label": "Cut step (m)", "default": 2 },
        { "type": "header", "content": "Messages" },
        { "type": "text", "id": "hint_area", "label": "Hint (area)", "default": "Enter your area to see the rolls you need." },
        { "type": "text", "id": "hint_dims", "label": "Hint (length × width)", "default": "Enter the length and width of your lawn to see the rolls you need." },
        { "type": "text", "id": "your_area_label", "label": "Area line", "default": "Your area:" },
        { "type": "text", "id": "coverage_label", "label": "Coverage line", "default": "m² of turf · from" }
      ]
    },
    {
      "type": "trade",
      "name": "Trade promo",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "pill", "label": "Pill label", "default": "Turf Mart Trade" },
        { "type": "text", "id": "title", "label": "Title", "default": "Better rates for bigger jobs." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "For installers, landscapers and builders." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Open a trade account" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "tile",
      "name": "Promo tile",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "measure", "label": "Measure" },
          { "value": "diy", "label": "DIY tools" },
          { "value": "chat", "label": "Chat / expert" },
          { "value": "kit", "label": "Install kit (box)" }
        ], "default": "measure" },
        { "type": "select", "id": "style", "label": "Style", "options": [
          { "value": "yellow", "label": "Yellow" },
          { "value": "white", "label": "White" }
        ], "default": "yellow" },
        { "type": "text", "id": "title", "label": "Title", "default": "How much turf do I need?" },
        { "type": "text", "id": "sub_desktop", "label": "Subtitle (desktop)", "default": "Measure up and order by the m²." },
        { "type": "text", "id": "sub_mobile", "label": "Subtitle (mobile)", "default": "Order by the m²." },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Promo tiles" }
  ]
}
{% endschema %}
